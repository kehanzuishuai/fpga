// ============================================================
// External PCM5102A DAC: the three pin lines, NOT ACTIVE.
//
// This file is not part of the project (it is not listed in the
// .gprj).  It only keeps the three lines ready.
//
// To switch the external DAC on, do BOTH, and only after the
// points in docs/PINOUT_AND_WIRING.md section 4 are settled:
//
//   1. src/tang_mega_138k_pro_top.v.v: remove the two slashes in
//      front of   `define EXT_PCM5102
//   2. copy the six lines at the end of this file to the end of
//      src/yinyue_fashengqi.cst
//
// One without the other must not be built: a port without a pin
// line is put on a pin of the tool's own choice.
//
// Where the pins come from (checked against documents on
// 2026-10-13, not yet tried on the board):
//
//   signal        FPGA  bank  net        socket J24 (PMOD1)
//   pcm5102_bclk  C24   5     PMOD1_IO0  pin 11
//   pcm5102_lrck  B24   5     PMOD1_IO4  pin 12
//   pcm5102_data  H15   5     PMOD1_IO7  pin 6
//   ground                               pin 3 or 4
//
//   - Dock schematic 4071f page 16: J24, nets and pin numbers.
//     The three nets go to J24 only.
//   - Pinout table, sheet BTB_J3: C24 = LVDS_IOB40P,
//     B24 = LVDS_IOB40N, H15 = LVDS_IOB83N, all bank 5.
//   - Dock schematic page 19: VCCIO5 is the Dock's 3.3 V.
//   - Pin report of the 2026-10-12 build: the three pins are
//     unused; C21/B20 (keys) and E22 (on-board DAC) in the same
//     bank work as LVCMOS33.
//   - HDMI on the Dock uses AB24/AC24, V24/W24, AA22/AA23,
//     Y22/Y23: no conflict.
// ============================================================

IO_LOC  "pcm5102_bclk" C24;
IO_PORT "pcm5102_bclk" IO_TYPE=LVCMOS33;

IO_LOC  "pcm5102_lrck" B24;
IO_PORT "pcm5102_lrck" IO_TYPE=LVCMOS33;

IO_LOC  "pcm5102_data" H15;
IO_PORT "pcm5102_data" IO_TYPE=LVCMOS33;



// ============================================================
// Tang Mega 138K Pro + Pro Dock
//
// Top:
// tang_mega_138k_pro_top
// ============================================================


// ============================================================
// 50 MHz board clock
// ============================================================

IO_LOC  "clk_50m" P16;
IO_PORT "clk_50m" IO_TYPE=LVCMOS33;


// ============================================================
// Board reset
// ============================================================

IO_LOC  "rst_n" K16;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;


// ============================================================
// HW-136 / TTP229
//
// PMOD2 / J26
//
// C21 = SCL
// B20 = SDO
// ============================================================

IO_LOC  "ttp229_scl" C21;
IO_PORT "ttp229_scl" IO_TYPE=LVCMOS33;

IO_LOC  "ttp229_sdo" B20;
IO_PORT "ttp229_sdo" IO_TYPE=LVCMOS33;


// ============================================================
// On-board PT8211-S DAC
//
// E22 = BCLK
// F24 = WS / LRCK
// G24 = DIN
// ============================================================

IO_LOC  "i2s_bclk" E22;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33;

IO_LOC  "i2s_lrck" F24;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33;

IO_LOC  "i2s_data" G24;
IO_PORT "i2s_data" IO_TYPE=LVCMOS33;


// ============================================================
// On-board XPT4809 headphone amplifier enable
// ============================================================

IO_LOC  "audio_pa_en" H17;
IO_PORT "audio_pa_en" IO_TYPE=LVCMOS33;

// Official Pro Dock4071f rev1.2 pages2/8: J11 DVI A(TX).
# Reference for Tang Mega 138K Pro / matching Pro Dock. Check board revision first.
IO_LOC "video_d_p[0]" AB24,AC24;
IO_PORT "video_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "video_d_p[1]" V24,W24;
IO_PORT "video_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "video_d_p[2]" AA22,AA23;
IO_PORT "video_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
IO_LOC "video_ck_p" Y22,Y23;
IO_PORT "video_ck_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;

// Local serializer reset registers: preserve measured recovery/removal skew.
INS_LOC "u_video_io/channels[0].local_rst_n_s1" R35C181[0][B];
INS_LOC "u_video_io/channels[1].local_rst_n_s1" R47C181[0][B];
INS_LOC "u_video_io/channels[2].local_rst_n_s1" R33C181[0][B];
// Keep the five reset flops on the peripheral regional clock near IOR33..47.
INS_LOC "u_video_io/reset_buffer" PTR3[0];

// Second TTP229: Pro Dock4071f rev1.2 page16, J26/PMOD2.
// SCL: J26 pin7 / PMOD2_IO2 / B19 / bank5, SDO: pin5 / IO3 / A17 / bank5.
// Module VCC -> J26 pin1 or2 (+3V3), GND -> pin3 or4. Independent buses.
IO_LOC "ttp229_2_scl" B19;
IO_PORT "ttp229_2_scl" IO_TYPE=LVCMOS33;
IO_LOC "ttp229_2_sdo" A17;
IO_PORT "ttp229_2_sdo" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ESP32-S3, 3.3 V, independent of the two TTP229 buses.
IO_LOC "esp_uart_rx" B21;
IO_PORT "esp_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "esp_uart_tx" A20;
IO_PORT "esp_uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "esp_spi_sck" L17;
IO_PORT "esp_spi_sck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "esp_spi_cs_n" H14;
IO_PORT "esp_spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "esp_spi_mosi" E25;
IO_PORT "esp_spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "esp_spi_miso" D25;
IO_PORT "esp_spi_miso" IO_TYPE=LVCMOS33;
